Package: ontologyAPI
Title: REST API Server for Ontology-Based R Packages
Version: 0.1.0
Authors@R:
    person("Ontology", "Developer", role = c("aut", "cre"),
           email = "dev@example.com")
Description: Exposes objectSetsR, actionTypesR, and conceptR as a JSON REST API
    via plumber. Enables Python, TypeScript, and LLM agents to query object sets,
    traverse links, evaluate concepts, and submit actions without writing R.
Depends: R (>= 4.0)
Imports:
    ontologySpecR,
    objectSetsR,
    actionTypesR,
    plumber (>= 1.2.0),
    jsonlite,
    rlang,
    cli
Suggests:
    conceptR,
    auditR,
    duckdb,
    DBI,
    callr,
    testthat (>= 3.0.0),
    httr2,
    knitr,
    rmarkdown
